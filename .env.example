# ============================================
# Nudge ERP — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# ---- Database ----
DATABASE_URL=postgresql://nudge:nudge_dev_password@localhost:5432/nudge_erp?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Application ----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Gmail Integration (Phase 3) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail/callback

# ---- AI Provider (Phase 3) ----
# OPENAI_API_KEY=
# AI_PROVIDER=mock

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ---- Demo Mode ----
DEMO_MODE=true
