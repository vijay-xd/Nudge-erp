generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ORG_ADMIN
  SALES
  PROCUREMENT
  WAREHOUSE
  FINANCE
  ANALYST
}

enum OrderStatus {
  IMPORTED
  PENDING_REVIEW
  APPROVED
  ALLOCATED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  RETURNED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  CREDIT_NOTE
}

enum InventoryTransactionType {
  OPENING_BALANCE
  GOODS_RECEIPT
  SALES_DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  RESERVATION
  RESERVATION_RELEASE
  RETURN_INWARD
  RETURN_OUTWARD
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  DAMAGE
  EXPIRY_WRITE_OFF
}

enum ImportStatus {
  PENDING
  PROCESSING
  EXTRACTED
  REVIEW_REQUIRED
  APPROVED
  REJECTED
  FAILED
  DUPLICATE
}

enum ChannelType {
  DIRECT
  BLINKIT
  ZEPTO
  SWIGGY_INSTAMART
  AMAZON
  FLIPKART
  OTHER_MARKETPLACE
  WHOLESALE
}

enum PaymentType {
  RECEIVED
  MADE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CREDIT
  OTHER
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  legalName   String?
  gstin       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  logoUrl     String?
  isDemo      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrganizationMembership[]
  vendors     Vendor[]
  customers   Customer[]
  products    Product[]
  categories  ProductCategory[]
  warehouses  Warehouse[]
  salesOrders SalesOrder[]
  purchaseOrders PurchaseOrder[]
  invoices    CustomerInvoice[]
  vendorBills VendorBill[]
  payments    Payment[]
  creditNotes CreditNote[]
  notifications Notification[]
  auditLogs   AuditLog[]
  integrations IntegrationConnection[]
  emailImports EmailImport[]
  salesChannels SalesChannel[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  isActive       Boolean  @default(true)
  isDemoUser     Boolean  @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    OrganizationMembership[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[] @relation("AuditActor")
  notifications  Notification[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           UserRole
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model Vendor {
  id              String   @id @default(uuid())
  organizationId  String
  legalName       String
  tradingName     String?
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  gstin           String?
  panNumber       String?
  paymentTermDays Int      @default(30)
  leadTimeDays    Int      @default(7)
  bankName        String?
  bankAccount     String?
  bankIfsc        String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  organization    Organization   @relation(fields: [organizationId], references: [id])
  purchaseOrders  PurchaseOrder[]
  vendorBills     VendorBill[]
  productVendors  ProductVendor[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("vendors")
}

model Customer {
  id              String      @id @default(uuid())
  organizationId  String
  legalName       String
  tradingName     String?
  contactPerson   String?
  email           String?
  phone           String?
  billingAddress  String?
  deliveryAddress String?
  city            String?
  state           String?
  pincode         String?
  gstin           String?
  channelType     ChannelType @default(DIRECT)
  externalId      String?
  paymentTermDays Int         @default(30)
  notes           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?

  organization    Organization  @relation(fields: [organizationId], references: [id])
  salesOrders     SalesOrder[]
  invoices        CustomerInvoice[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("customers")
}

model SalesChannel {
  id              String      @id @default(uuid())
  organizationId  String
  name            String
  channelType     ChannelType
  externalId      String?
  isActive        Boolean     @default(true)
  config          Json?       @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  channelSkuMaps  ChannelSKUMap[]
  salesOrders     SalesOrder[]

  @@unique([organizationId, channelType, externalId])
  @@index([organizationId])
  @@map("sales_channels")
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  parentId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  parent         ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("CategoryHierarchy")
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("product_categories")
}

model Product {
  id              String   @id @default(uuid())
  organizationId  String
  sku             String
  name            String
  description     String?
  brand           String?
  categoryId      String?
  unitOfMeasure   String   @default("PCS")
  barcode         String?
  hsnCode         String?
  gstRate         Decimal  @default(18) @db.Decimal(5, 2)
  purchaseCost    Decimal? @db.Decimal(12, 2)
  sellingPrice    Decimal? @db.Decimal(12, 2)
  mrp             Decimal? @db.Decimal(12, 2)
  reorderLevel    Int      @default(0)
  batchTracking   Boolean  @default(false)
  expiryTracking  Boolean  @default(false)
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  organization    Organization @relation(fields: [organizationId], references: [id])
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  channelSkuMaps  ChannelSKUMap[]
  productVendors  ProductVendor[]
  inventoryBatches InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  salesOrderLines  SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, barcode])
  @@map("products")
}

model ProductVendor {
  id             String  @id @default(uuid())
  productId      String
  vendorId       String
  vendorSku      String?
  cost           Decimal? @db.Decimal(12, 2)
  isPreferred    Boolean @default(false)
  leadTimeDays   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product @relation(fields: [productId], references: [id])
  vendor         Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([productId, vendorId])
  @@map("product_vendors")
}

model ChannelSKUMap {
  id             String       @id @default(uuid())
  productId      String
  channelId      String
  externalSku    String
  externalName   String?
  channelPrice   Decimal?     @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  product        Product      @relation(fields: [productId], references: [id])
  channel        SalesChannel @relation(fields: [channelId], references: [id])

  @@unique([channelId, externalSku])
  @@map("channel_sku_maps")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  pincode        String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  stockLocations StockLocation[]
  inventoryBatches InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  goodsReceipts  GoodsReceipt[]
  shipments      Shipment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model StockLocation {
  id           String    @id @default(uuid())
  warehouseId  String
  name         String
  code         String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
  @@map("stock_locations")
}

model InventoryBatch {
  id             String    @id @default(uuid())
  productId      String
  warehouseId    String
  batchNumber    String?
  lotNumber      String?
  expiryDate     DateTime?
  manufacturingDate DateTime?
  quantity       Decimal   @db.Decimal(12, 3)
  reservedQty    Decimal   @default(0) @db.Decimal(12, 3)
  unitCost       Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product        Product   @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId, warehouseId])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model InventoryTransaction {
  id               String                   @id @default(uuid())
  organizationId   String
  productId        String
  warehouseId      String
  transactionType  InventoryTransactionType
  quantity         Decimal                  @db.Decimal(12, 3)
  unitCost         Decimal?                 @db.Decimal(12, 2)
  batchNumber      String?
  referenceType    String?
  referenceId      String?
  notes            String?
  createdAt        DateTime                 @default(now())
  createdBy        String?

  product          Product   @relation(fields: [productId], references: [id])
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([organizationId])
  @@index([productId, warehouseId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model InventoryReservation {
  id              String   @id @default(uuid())
  organizationId  String
  productId       String
  warehouseId     String
  salesOrderId    String
  salesOrderLineId String
  quantity        Decimal  @db.Decimal(12, 3)
  fulfilledQty    Decimal  @default(0) @db.Decimal(12, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@index([organizationId])
  @@index([salesOrderId])
  @@index([productId, warehouseId])
  @@map("inventory_reservations")
}

model SalesOrder {
  id               String      @id @default(uuid())
  organizationId   String
  orderNumber      String
  customerId       String
  channelId        String?
  externalOrderId  String?
  orderDate        DateTime    @default(now())
  expectedDelivery DateTime?
  status           OrderStatus @default(IMPORTED)
  source           String      @default("manual")
  subtotal         Decimal     @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal     @default(0) @db.Decimal(14, 2)
  discountAmount   Decimal     @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal     @default(0) @db.Decimal(14, 2)
  notes            String?
  reviewedBy       String?
  reviewedAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        String?

  organization     Organization    @relation(fields: [organizationId], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [id])
  channel          SalesChannel?   @relation(fields: [channelId], references: [id])
  lines            SalesOrderLine[]
  shipments        Shipment[]
  invoices         CustomerInvoice[]
  reservations     InventoryReservation[]
  emailImport      EmailImport?    @relation(fields: [emailImportId], references: [id])
  emailImportId    String?

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, externalOrderId, channelId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, orderDate])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id             String   @id @default(uuid())
  salesOrderId   String
  productId      String
  quantity       Decimal  @db.Decimal(12, 3)
  fulfilledQty   Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(18) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(14, 2)
  isCancelled    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id])
  shipmentLines  ShipmentLine[]

  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  organizationId   String
  poNumber         String
  vendorId         String
  orderDate        DateTime            @default(now())
  expectedDelivery DateTime?
  status           PurchaseOrderStatus @default(DRAFT)
  subtotal         Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal             @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal             @default(0) @db.Decimal(14, 2)
  notes            String?
  approvedBy       String?
  approvedAt       DateTime?
  sentAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String?

  organization     Organization     @relation(fields: [organizationId], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  vendorBills      VendorBill[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal  @db.Decimal(12, 3)
  receivedQty      Decimal  @default(0) @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(12, 2)
  taxRate          Decimal  @default(18) @db.Decimal(5, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id               String   @id @default(uuid())
  organizationId   String
  receiptNumber    String
  purchaseOrderId  String
  warehouseId      String
  receivedDate     DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse        Warehouse     @relation(fields: [warehouseId], references: [id])
  lines            GoodsReceiptLine[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String   @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  productId           String
  receivedQty         Decimal  @db.Decimal(12, 3)
  acceptedQty         Decimal  @db.Decimal(12, 3)
  rejectedQty         Decimal  @default(0) @db.Decimal(12, 3)
  batchNumber         String?
  expiryDate          DateTime?
  unitCost            Decimal? @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime @default(now())

  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

model Shipment {
  id              String   @id @default(uuid())
  organizationId  String
  shipmentNumber  String
  salesOrderId    String
  warehouseId     String
  dispatchDate    DateTime?
  carrier         String?
  trackingNumber  String?
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  lines           ShipmentLine[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@map("shipments")
}

model ShipmentLine {
  id                String   @id @default(uuid())
  shipmentId        String
  salesOrderLineId  String
  productId         String
  pickedQty         Decimal  @db.Decimal(12, 3)
  packedQty         Decimal  @default(0) @db.Decimal(12, 3)
  shippedQty        Decimal  @default(0) @db.Decimal(12, 3)
  batchNumber       String?
  createdAt         DateTime @default(now())

  shipment          Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderLine    SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])

  @@index([shipmentId])
  @@map("shipment_lines")
}

model CustomerInvoice {
  id              String        @id @default(uuid())
  organizationId  String
  invoiceNumber   String
  customerId      String
  salesOrderId    String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?

  organization    Organization  @relation(fields: [organizationId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  salesOrder      SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  lines           CustomerInvoiceLine[]
  paymentAllocations PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id              String   @id @default(uuid())
  invoiceId       String
  productId       String
  description     String?
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(12, 2)
  taxRate         Decimal  @default(18) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal  @default(0) @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  invoice         CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("customer_invoice_lines")
}

model VendorBill {
  id              String        @id @default(uuid())
  organizationId  String
  billNumber      String
  vendorId        String
  purchaseOrderId String?
  billDate        DateTime      @default(now())
  dueDate         DateTime?
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?

  organization    Organization   @relation(fields: [organizationId], references: [id])
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  paymentAllocations PaymentAllocation[]

  @@unique([organizationId, billNumber])
  @@index([organizationId])
  @@index([vendorId])
  @@map("vendor_bills")
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  paymentNumber   String
  paymentType     PaymentType
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now())
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?

  organization    Organization       @relation(fields: [organizationId], references: [id])
  allocations     PaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@map("payments")
}

model PaymentAllocation {
  id              String           @id @default(uuid())
  paymentId       String
  invoiceId       String?
  vendorBillId    String?
  amount          Decimal          @db.Decimal(14, 2)
  createdAt       DateTime         @default(now())

  payment         Payment          @relation(fields: [paymentId], references: [id])
  invoice         CustomerInvoice? @relation(fields: [invoiceId], references: [id])
  vendorBill      VendorBill?      @relation(fields: [vendorBillId], references: [id])

  @@index([paymentId])
  @@map("payment_allocations")
}

model CreditNote {
  id              String   @id @default(uuid())
  organizationId  String
  creditNoteNumber String
  invoiceId       String?
  customerId      String?
  amount          Decimal  @db.Decimal(14, 2)
  reason          String?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId])
  @@map("credit_notes")
}

model IntegrationConnection {
  id              String   @id @default(uuid())
  organizationId  String
  provider        String
  accountEmail    String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  scopes          String?
  config          Json?    @default("{}")
  isActive        Boolean  @default(false)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integration_connections")
}

model EmailImport {
  id              String       @id @default(uuid())
  organizationId  String
  messageId       String
  subject         String?
  senderEmail     String?
  receivedAt      DateTime?
  attachmentName  String?
  attachmentHash  String?
  status          ImportStatus @default(PENDING)
  extractedData   Json?
  confidenceScore Decimal?     @db.Decimal(5, 2)
  errorMessage    String?
  processedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  salesOrders     SalesOrder[]

  @@unique([organizationId, messageId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("email_imports")
}

model AIExtraction {
  id              String   @id @default(uuid())
  emailImportId   String?
  provider        String
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  rawResponse     Json?
  extractedFields Json?
  confidenceScore Decimal? @db.Decimal(5, 2)
  processingTimeMs Int?
  createdAt       DateTime @default(now())

  @@index([emailImportId])
  @@map("ai_extractions")
}

model Notification {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String?
  type            String
  title           String
  message         String
  entityType      String?
  entityId        String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  user            User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id              String   @id @default(uuid())
  organizationId  String
  actorId         String?
  action          String
  entityType      String
  entityId        String?
  changes         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  actor           User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType])
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
